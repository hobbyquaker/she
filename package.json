{
    "name": "mqtt-scripts",
    "version": "1.2.2",
    "description": "Node.js based script runner for use in MQTT based Smart Home environments",
    "main": "index.js",
    "scripts": {
        "test": "cross-env NODE_OPTIONS=\"--no-warnings\" jest --forceExit",
        "test:coverage": "cross-env NODE_OPTIONS=\"--no-warnings\" jest --coverage --forceExit",
        "test:verbose": "cross-env NODE_OPTIONS=\"--no-warnings\" jest --verbose --forceExit",
        "lint": "eslint --cache --cache-location .cache/.eslintcache .",
        "lint:fix": "eslint --cache --cache-location .cache/.eslintcache --fix .",
        "format": "prettier --cache --cache-location .cache/.prettiercache --write .",
        "format:check": "prettier --cache --cache-location .cache/.prettiercache --check ."
    },
    "bin": {
        "mqtt-scripts": "index.js"
    },
    "author": "Sebastian 'hobbyquaker' Raff <hobbyquaker@gmail.com>",
    "license": "MIT",
    "dependencies": {
        "coffee-compiler": "^0.3.2",
        "coffee-script": "^1.12.7",
        "mqtt": "^2.9.2",
        "node-schedule": "^1.2.3",
        "suncalc": "^1.8.0",
        "watch": "^1.0.2",
        "yalm": "^4.0.2",
        "yargs": "^12.0.5"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@sinonjs/fake-timers": "^11.0.0",
        "@types/jest": "^29.5.0",
        "@types/node": "^22.0.0",
        "aedes": "^0.50.0",
        "cross-env": "^7.0.3",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-n": "^17.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "globals": "^16.0.0",
        "jest": "^29.7.0",
        "prettier": "^3.0.0"
    },
    "directories": {
        "doc": "doc"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/hobbyquaker/mqtt-scripts"
    },
    "keywords": [
        "MQTT",
        "javascript",
        "coffeescript",
        "node.js",
        "npm",
        "sandbox",
        "vm",
        "Smart",
        "Home",
        "Internet",
        "of",
        "Things",
        "IoT"
    ],
    "bugs": {
        "url": "https://github.com/hobbyquaker/mqtt-scripts/issues"
    },
    "homepage": "https://github.com/hobbyquaker/mqtt-scripts"
}
