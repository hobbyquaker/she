[Unit]
Description=Smart Home Engine (she)
Documentation=https://github.com/hobbyquaker/she
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=nobody
Group=nogroup
Restart=on-failure
RestartSec=5s

ExecStart=/usr/bin/node /usr/local/lib/node_modules/smart-home-engine/src/index.js \
    --url mqtt://127.0.0.1 \
    --dir /etc/smart-home-engine/scripts \
    --config /etc/smart-home-engine/config.json \
    --port 1884 \
    --verbosity info

# Allow reading/writing script directory and config
ReadWritePaths=/etc/smart-home-engine

StandardOutput=journal
StandardError=journal
SyslogIdentifier=she

[Install]
WantedBy=multi-user.target
